{
  "name": "modelschemas",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "version-packages": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "dev": "pnpm run db:migrate && vite dev --port 3100",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/schema-studio && tsc --noEmit -p examples/image-dimensions && tsc --noEmit -p examples/video-composer",
    "prepare": "lefthook install",
    "format": "oxfmt && oxlint --type-aware --fix",
    "check": "oxfmt --check",
    "deploy": "pnpm run build && pnpm run deploy:ci",
    "deploy:ci": "wrangler d1 migrations apply modelschemas --remote && wrangler deploy",
    "seed": "node --import ./scripts/register-hash-imports.mjs scripts/seed.ts",
    "secrets:check": "node --import ./scripts/register-hash-imports.mjs scripts/push-secrets.ts",
    "secrets:push": "node --import ./scripts/register-hash-imports.mjs scripts/push-secrets.ts --push",
    "secrets:pull": "node --import ./scripts/register-hash-imports.mjs scripts/pull-secrets.ts --write",
    "secrets:build": "node --import ./scripts/register-hash-imports.mjs scripts/build-with-secrets.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio": "drizzle-kit studio",
    "openapi:emit": "node --import ./scripts/register-hash-imports.mjs scripts/emit-openapi.ts",
    "generate:client": "pnpm run openapi:emit && pnpm --dir packages/client exec openapi-ts",
    "check:client": "pnpm run generate:client && git diff --exit-code openapi.json packages/client",
    "types": "wrangler types --include-runtime=false",
    "npm:pack": "node --import ./scripts/register-hash-imports.mjs scripts/npm-pack.ts",
    "gap:report": "node --import ./scripts/register-hash-imports.mjs scripts/gap-report.ts",
    "compare:models-dev": "node --import ./scripts/register-hash-imports.mjs scripts/compare-models-dev.ts",
    "probe": "node --import ./scripts/register-hash-imports.mjs scripts/probe.ts",
    "rederive": "node --import ./scripts/register-hash-imports.mjs scripts/rederive.ts",
    "emit-skill": "node --import ./scripts/register-hash-imports.mjs scripts/emit-skill.ts",
    "client-smoke": "node --import ./scripts/register-hash-imports.mjs scripts/client-smoke.ts",
    "agent-roundtrip": "node --import ./scripts/register-hash-imports.mjs scripts/agent-roundtrip.ts",
    "pull-roundtrip": "node --import ./scripts/register-hash-imports.mjs scripts/pull-roundtrip.ts",
    "compare-fal": "node --import ./scripts/register-hash-imports.mjs scripts/compare-fal-extract-models.ts",
    "fal-extract-smoke": "node --import ./scripts/register-hash-imports.mjs scripts/fal-extract-smoke.ts",
    "mirror-catalog": "node scripts/mirror-catalog.ts",
    "cli": "node --import ./scripts/register-hash-imports.mjs packages/cli/src/index.ts"
  },
  "dependencies": {
    "@better-auth/agent-auth": "^0.6.2",
    "@better-auth/api-key": "^1.7.13",
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@modelschemas/rate-card": "workspace:*",
    "@posthog/react": "^1.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "1.0.1",
    "@tanstack/ai-anthropic": "1.0.0",
    "@tanstack/ai-client": "latest",
    "@tanstack/ai-cloudflare": "1.0.0",
    "@tanstack/ai-gemini": "latest",
    "@tanstack/ai-ollama": "latest",
    "@tanstack/ai-openai": "latest",
    "@tanstack/ai-react": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-store": "latest",
    "@tanstack/router-plugin": "^1.168.48",
    "@tanstack/store": "latest",
    "better-auth": "^1.7.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "posthog-js": "^1.438.23",
    "posthog-node": "^5.57.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@hey-api/openapi-ts": "0.0.0-next-20260930190945",
    "@modelschemas/client": "workspace:*",
    "@modelschemas/codegen": "workspace:*",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-event-client": "latest",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.9",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.15",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
